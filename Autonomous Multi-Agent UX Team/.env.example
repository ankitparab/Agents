# Choose "single" to use one configured LLM for all three agents, or "separate"
# to configure the Supervisor, UX Critique, and Variant Generator independently.
AGENT_MODEL_MODE=single

# Shared single-model configuration. For an OpenAI-compatible provider use a base
# URL ending in /v1; for example https://api.openai.com/v1. Do not commit real keys.
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# When AGENT_MODEL_MODE=separate, optionally override any role below. Unset values
# inherit the shared configuration above. Use provider=ollama with a local endpoint
# and leave the matching *_LLM_API_KEY blank.
ORCHESTRATOR_LLM_PROVIDER=
ORCHESTRATOR_LLM_MODEL=
ORCHESTRATOR_LLM_API_KEY=
ORCHESTRATOR_LLM_BASE_URL=
UX_CRITIQUE_LLM_PROVIDER=
UX_CRITIQUE_LLM_MODEL=
UX_CRITIQUE_LLM_API_KEY=
UX_CRITIQUE_LLM_BASE_URL=
VARIANT_GENERATOR_LLM_PROVIDER=
VARIANT_GENERATOR_LLM_MODEL=
VARIANT_GENERATOR_LLM_API_KEY=
VARIANT_GENERATOR_LLM_BASE_URL=

# Maximum parsed JSON request size accepted by the local development server.
MAX_REQUEST_BYTES=1048576
